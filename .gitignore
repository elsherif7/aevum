# ── Build / packaging ─────────────────────────────────────────────────────
aevum.egg-info/
build/
dist/
*.egg-info/
*.egg

# ── Python bytecode ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── Virtual environments ──────────────────────────────────────────────────
.venv/
venv/
env/
.env/

# ── Test / coverage artefacts ─────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ── Type checker caches ───────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json

# ── Ruff cache ────────────────────────────────────────────────────────────
.ruff_cache/

# ── Editor / OS artefacts ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# ── Aevum runtime data (never commit user data) ───────────────────────────
# These live in %LOCALAPPDATA%\Aevum\ / ~/.local/share/Aevum/ at runtime,
# but guard against anyone accidentally running aevum from inside the repo.
cache/
history/
yt_video_cache.json
yt_quota_tracker.json
yt_ratelimit.json
config.json
